{
  "name": "job-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Seguimiento de solicitudes de empleo: empresa, rol, modalidad, estado, historial y estadísticas.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dev:demo": "cross-env NEXT_PUBLIC_DEMO=true next dev",
    "build:demo": "cross-env NEXT_PUBLIC_DEMO=true next build",
    "start:demo": "cross-env NEXT_PUBLIC_DEMO=true next start",
    "seed": "tsx scripts/seed.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "cross-env": "^7.0.3",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
